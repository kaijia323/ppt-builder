    "properties": {
     "page": {
      "type": [
       "integer"
      ]
     },
     "type": {
      "type": "string"
     },
     "severity": {
      "type": "string",
      "enum": [
       "high",
       "medium",
       "low"
      ]
     },
     "problem": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     },
     "ids": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    },
    "required": [

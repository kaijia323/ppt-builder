{
 "type": "object",
 "properties": {
  "overall": {
   "type": "object",
   "properties": {
    "score": {
     "type": [
      "number",
      "integer"
     ]
    },
    "summary": {
     "type": "string"
    },
    "strengths": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   },
   "required": [
